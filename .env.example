# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# docker-compose.db.yml (and docker-compose.yml) read POSTGRES_* from .env.
# The host-run Go binary can also pick up CR_CONF_* after you export them:
#   set -a && source .env && set +a
#   go run . -w -c ./data/conf.ini
#
# Prefer the double-underscore form (CR_CONF_Section__Key) so Compose/TOML
# loaders do not mangle dotted names. Both forms are accepted by Cloudreve.

# --- PostgreSQL container (docker-compose.db.yml) ---
POSTGRES_IMAGE=postgres:17
POSTGRES_USER=cloudreve
POSTGRES_PASSWORD=cloudreve_dev
POSTGRES_DB=cloudreve
POSTGRES_PORT=5432

# Host the Go binary uses to reach Postgres published on the host.
# Inside docker-compose.yml the app service overrides Host to the compose
# service name (postgresql).
POSTGRES_HOST=127.0.0.1

# --- Cloudreve Database overrides (always Postgres in this workspace) ---
CR_CONF_Database__Type=postgres
CR_CONF_Database__Host=127.0.0.1
CR_CONF_Database__Port=5432
CR_CONF_Database__User=cloudreve
CR_CONF_Database__Password=cloudreve_dev
CR_CONF_Database__Name=cloudreve
