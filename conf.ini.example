; Copy to data/conf.ini (or pass with -c). data/ is gitignored.
; Prefer matching credentials with .env / .env.example so they stay in sync.
; Any value can be overridden at runtime with CR_CONF_Section__Key env vars.
[System]
Debug = true
Mode = master
Listen = :5212
SessionSecret = change-me-to-a-long-random-string
HashIDSalt = change-me-too
LogLevel = debug

[Database]
Type = postgres
Host = 127.0.0.1
Port = 5432
User = cloudreve
Password = cloudreve_dev
Name = cloudreve
